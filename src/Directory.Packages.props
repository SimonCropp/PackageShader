    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="30.0.1" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" Pinned="true" />
    <PackageVersion Include="Microsoft.Build.Tasks.Core" Version="18.9.6" Pinned="true" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.ILVerification" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Nullable" Version="1.3.1" />
    <PackageVersion Include="Polyfill" Version="12.0.0" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.191" />
    <PackageVersion Include="ProjectFiles" Version="1.6.0" />
    <PackageVersion Include="System.Reflection.Metadata" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <PackageVersion Include="Verify.XunitV3" Version="33.7.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="DiffEngine" Version="21.2.1" />
    <PackageVersion Include="EmptyFiles" Version="8.20.1" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.1" />
    <PackageVersion Include="Verify" Version="33.7.2" />
  </ItemGroup>
</Project>
