    <PackageVersion Include="Microsoft.Build.Tasks.Core" Version="18.9.6" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.ILVerification" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Nullable" Version="1.3.1" />
    <PackageVersion Include="Polyfill" Version="11.2.0" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.180" />
    <PackageVersion Include="ProjectFiles" Version="1.4.0" />
    <PackageVersion Include="System.Reflection.Metadata" Version="10.0.11" />
