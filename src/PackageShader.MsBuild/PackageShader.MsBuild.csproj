<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>
  <ItemGroup>
    <Content Include=".\bin\$(Configuration)\PackageShader.MsBuild.dll">
      <Pack>true</Pack>
      <PackagePath>task</PackagePath>
    </Content>
    <Content Include="$(SolutionDir)PackageShader\bin\$(Configuration)\netstandard2.0\PackageShader.dll">
      <Pack>true</Pack>
      <PackagePath>task</PackagePath>
    </Content>
    <Content Include="build\PackageShader.MsBuild.targets">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </Content>
    <Content Include="buildMultiTargeting\PackageShader.MsBuild.targets">
      <Pack>true</Pack>
      <PackagePath>buildMultiTargeting</PackagePath>
    </Content>
    <!-- Both are supplied by the MSBuild that loads the task, so neither is a dependency of the
         package. Declared, they flow into every project that uses the task: System.Text.Json
         11.0.0 is not pruned on net10.0, so such a project compiled against System.Text.Json and
         System.Text.Encodings.Web 11.0.0.0 and failed to load them on a .NET 10 host. -->
    <PackageReference Include="Microsoft.Build.Tasks.Core" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" PrivateAssets="all" />
    <ProjectReference Include="..\PackageShader\PackageShader.csproj" PrivateAssets="All" />
  </ItemGroup>
</Project>
